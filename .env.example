# Server & App Configuration
PORT=8000
APP_BASE_URL=https://duckit-engine.onrender.com
# Generate a fresh value with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SESSION_SECRET=replace_me_with_a_random_64_char_hex_secret
# Leave unset to derive it from APP_BASE_URL (https -> Secure cookies).
# COOKIE_SECURE=true
# Optional: point the engine at a different working directory for the SQLite
# database, uploads and private outputs.
# DUCKIT_DATA_DIR=/var/lib/duckit

# Public identity used by the legal pages, the footer and support links.
COMPANY_NAME=Duck It
SUPPORT_EMAIL=support@duckit.app
PRO_PRICE_LABEL=£9/mo
LEGAL_JURISDICTION=England and Wales

# Engine tuning (values are clamped server-side before use).
# MAX_SOURCE_SECONDS=3600
# ENVELOPE_ATTACK_MS=350
# ENVELOPE_RELEASE_MS=450
# MAX_CONCURRENT_JOBS=1

# Stripe Billing Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here 
STRIPE_PRICE_PRO_MONTHLY=price_1Uc9PF14qrIUsdrZe74LHw2L
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# PostHog Analytics & Feature Flags
POSTHOG_PROJECT_TOKEN=phc_your_project_api_key_here
POSTHOG_HOST=https://us.i.posthog.com